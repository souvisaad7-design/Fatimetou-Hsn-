# ===== متغيرات الخادم (Vercel → Settings → Environment Variables) — لا تظهر في المتصفح =====
# مفتاح YouTube Data API v3 (من Google Cloud Console)
YOUTUBE_API_KEY=
# حماية مسار المزامنة /api/youtube/sync (أي نص عشوائي طويل)
CRON_SECRET=
# مشروع Supabase الخاص بالجمعية (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# اختياري: قناة أخرى
# YOUTUBE_CHANNEL_HANDLE=@associationaidesoutien

# ===== متغيرات الواجهة (تُضمَّن في الموقع عند البناء) =====
# على GitHub Pages فقط: رابط دالة البحث في مشروع Vercel
# VITE_VIDEO_SEARCH_URL=https://your-project.vercel.app/api/youtube/search
# لإيقاف ميزة الفيديوهات
# VITE_VIDEOS_ENABLED=false
