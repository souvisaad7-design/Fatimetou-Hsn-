{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/admin", "destination": "/admin/", "permanent": true },
    { "source": "/assistant", "destination": "/assistant/", "permanent": true },
    { "source": "/live", "destination": "/live/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "https://souvisaad7-design.github.io/Fatimetou-Hsn-/index.html" },
    { "source": "/admin/", "destination": "https://souvisaad7-design.github.io/Fatimetou-Hsn-/admin/index.html" },
    { "source": "/assistant/", "destination": "https://souvisaad7-design.github.io/Fatimetou-Hsn-/assistant/index.html" },
    { "source": "/live/", "destination": "https://souvisaad7-design.github.io/Fatimetou-Hsn-/live/index.html" },
    { "source": "/:path*", "destination": "https://souvisaad7-design.github.io/Fatimetou-Hsn-/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), display-capture=(self), geolocation=()" }
      ]
    }
  ]
}
